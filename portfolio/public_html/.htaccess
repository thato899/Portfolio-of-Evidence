Options -Indexes
DirectoryIndex index.html

# Protect the includes folder
RedirectMatch 403 ^/includes/.*$

# Protect the admin folder with password (you'll set this in cPanel)
AuthType Basic
AuthName "Admin Access"
AuthUserFile /home/yourcpanelusername/public_html/admin/.htpasswd
Require valid-user

# Set upload limits
php_value upload_max_filesize 50M
php_value post_max_size 50M
php_value max_execution_time 300